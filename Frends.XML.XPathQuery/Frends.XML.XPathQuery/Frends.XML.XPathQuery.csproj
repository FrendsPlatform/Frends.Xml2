<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <AssemblyName>Frends.XML.XPathQuery</AssemblyName>
        <RootNamespace>Frends.XML.XPathQuery</RootNamespace>
        <!-- SaxonCS 12.5.0 pulls in ICU4N.Resources with invalid locale folders. Saxon licence only covers 12.5, so it can't be upgraded, without upgrading Saxon.Activation. -->
        <NoWarn>$(NoWarn);NETSDK1188</NoWarn>

        <Version>2.3.0</Version>
        <Authors>Frends</Authors>
        <Copyright>Frends</Copyright>
        <Company>Frends</Company>
        <Product>Frends</Product>
        <PackageTags>Frends</PackageTags>
        <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Description>Task for querying XML using XPath queries.</Description>
        <PackageProjectUrl>https://frends.com/</PackageProjectUrl>
        <RepositoryUrl>https://github.com/FrendsPlatform/Frends.Xml2/tree/main/Frends.XML.XPathQuery</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="FrendsTaskAnalyzers" Version="1.11.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Frends.Saxon.Activation" Version="1.1.4"/>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="SaxonCS" Version="12.5.0"/>
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Frends.XML.XPathQuery.Tests" />
        <AdditionalFiles Include="FrendsTaskMetadata.json" />
    </ItemGroup>
    <ItemGroup>
        <None Include="FrendsTaskMetadata.json" Pack="true" PackagePath="/">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="../LICENSE.md" Pack="true" PackagePath="/">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
